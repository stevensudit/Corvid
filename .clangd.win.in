# clangd configuration (Windows / clang++). Generated from `.clangd.win.in` by
# `tests/CMakeLists.txt` via `configure_file` and gitignored (rewritten on every
# configure). Edit this template, not the generated `.clangd`. The Linux variant
# is `.clangd.in`; the two diverge because Windows builds with clang++ against
# the MSVC STL (no libc++) and only the portable/cuda buckets exist (no
# ngtcp2/openssl/liburing isystem paths).
CompileFlags:
  # compile_commands.json (under tests/build) carries the real clang++ command
  # for every test .cpp/.cu, including -std=c++23 and the include paths. Headers
  # under corvid/ have no entry of their own and inherit flags from the nearest
  # indexed TU that includes them.
  CompilationDatabase: tests/build
  # SDL3 and ImGui sit behind -isystem only on the TU commands that use them, so
  # a standalone parse of a vendored SDL header or imgui_overlay.h inherits a
  # command without them and resolves no types; add them globally (harmless
  # extra search paths). ImGui needs both its source root and backends dir.
  # `-DCORVID_CLANGD` marks clangd's parse so the implementation headers under
  # `details/` tolerate a standalone open instead of failing their entry-point
  # check.
  Add: [-isystem, @CORVID_CLANGD_SDL_INCLUDE@, -isystem, @CORVID_CLANGD_IMGUI_INCLUDE@, -isystem, @CORVID_CLANGD_IMGUI_BACKENDS@, -DCORVID_CLANGD]

---
# CUDA sources/headers (corvid/cuda/, tests/*.cu). A .cu has a clang++ CUDA entry
# in compile_commands.json that clangd parses directly, but a .cuh header has no
# entry and would be parsed as plain C++, flagging the CUDA attributes
# (__host__, __device__, __global__) and the <<<...>>> launch syntax as unknown.
# Put clangd into CUDA mode with clang's own CUDA frontend: -xcuda plus the
# toolkit path (derived from nvcc at configure time). --no-cuda-version-check
# silences the note that the 13.3 toolkit is newer than clang 22's last fully
# supported version; parsing is unaffected.
If:
  PathMatch: [.*\.cu, .*\.cuh]
CompileFlags:
  Compiler: C:/Program Files/LLVM/bin/clang++.exe
  Add: [@CORVID_CLANGD_CUDA_FLAGS@]

---
# Our own headers. A header has no entry of its own in compile_commands.json, so
# clangd parses it with the command of whatever proxy TU it picks, and here that
# is imgui.cpp, which the build compiles with `-w` (see `corvid_require_imgui` in
# tests/CMakeLists.txt). Inheriting that `-w` silenced every compiler warning in
# every corvid header in the editor, so drop it and let the `-Wall -Wextra
# -Werror` already on that command through. clang-tidy findings were never
# affected: clangd routes those around `-w`.
#
# Only one `-Wno-*` proves necessary. Opening all 219 corvid headers through
# clangd with `-w` gone yields exactly two warnings, and just one of them is an
# artifact of the standalone parse: a header analyzed on its own has no caller,
# so a constant it defines for the rest of the program looks unused (`vec.cuh`'s
# `big_value`, used across the game headers). Resist padding this list
# speculatively, since every entry here is a real diagnostic the editor stops
# showing. `unused-const-variable` rather than the broader `unused-variable`
# that the Linux template uses, so a genuinely unused local still gets flagged.
If:
  PathMatch: [corvid/.*]
CompileFlags:
  Remove: [-w]
  Add: [-Wno-unused-const-variable]

---
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
