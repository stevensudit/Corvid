Checks: >
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-core.StackAddressEscape,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-invalid-enum-default-initialization,
  -bugprone-signed-bitwise,
  modernize-*,
  -modernize-concat-nested-namespaces,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -modernize-use-designated-initializers,
  -modernize-avoid-c-style-cast,
  -modernize-use-string-view,
  performance-*,
  -performance-faster-string-find,
  readability-*,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -readability-magic-numbers,
  -readability-simplify-boolean-expr,
  -readability-named-parameter,
  -readability-implicit-bool-conversion,
  -readability-static-accessed-through-instance,
  -readability-use-anyofallof,
  -readability-avoid-nested-conditional-operator,
  -readability-container-size-empty,
  -readability-qualified-auto,
  -readability-else-after-return,
  -readability-redundant-access-specifiers,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-inconsistent-ifelse-braces,
  -readability-redundant-parentheses,
  -readability-trailing-comma,
  -readability-redundant-lambda-parameter-list,
  -readability-redundant-nested-if,
  -readability-trivial-switch,
  misc-unused-parameters
WarningsAsErrors: ''
# Both separators: on Windows a header reached through a relative include comes
# out as `...\corvid\strings/streaming.h`, which `corvid/.*` never matches, so
# the whole library went unanalyzed there.
HeaderFilterRegex: 'corvid[/\\].*'
FormatStyle: file
